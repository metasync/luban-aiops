# SPEC-062 R-7: secure password generation dev posture. Merged into the
# platform-runtime-config ConfigMap by the dev-k8s overlay; the base keeps
# GATEWAY_SECRETS_ENABLED=false (deny-by-default), so an overlay that does not
# include this profile renders byte-identical to the default posture.
#
# This flag alone activates read-tier generation: the password-policy contract is
# already mounted at /etc/luban/policy/password-policy.yaml via the base
# platform-policy ConfigMap (GATEWAY_PASSWORD_POLICY_PATH), so no extra mount is
# needed. Email delivery stays inert here — no SMTP host/TLS is configured by
# this profile — so only generation plus the one-time portal-copy handoff are
# enabled. secrets.deliver(channel="email") still fails closed with
# EMAIL_NOT_CONFIGURED until SMTP is provisioned out-of-band by
# sync-email-secrets.sh.
GATEWAY_SECRETS_ENABLED=true
