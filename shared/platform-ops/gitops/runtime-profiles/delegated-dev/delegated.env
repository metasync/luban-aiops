# SPEC-070 delegated outbound user-identity — dev posture, DISABLED BY DEFAULT.
#
# Merged into platform-runtime-config by the delegated-dev overlay ONLY (never by
# dev-k8s). Every gate below is held explicitly false so that merely deploying
# this overlay changes nothing at runtime: the delegated invoke / acquisition /
# authorization routes stay closed until an operator (a) provisions the keyring,
# the administered config + identity mapping, and the custody database, and
# (b) flips the relevant gate here and redeploys.
#
# No secret lives in this file. The custody DSN, the keyring, and the administered
# config/mapping are mounted as secret FILES (see tool-gateway-delegated.yaml and
# sync-custody-db.sh / sync-browser-credentials.sh). Only non-secret flags and
# mount paths are set here, and even those stay commented until provisioning.

# --- feature gates (plan line 165: "feature flags") ------------------------
# Three INDEPENDENT gates; each defaults false in core/config.py and is held
# false here so the overlay is inert. Enable only the surface you have
# provisioned and intend to expose.
GATEWAY_DELEGATED_INVOKE_ENABLED=false
GATEWAY_DELEGATED_ACQUISITION_ENABLED=false
GATEWAY_DELEGATED_AUTHORIZATION_ENABLED=false

# --- custody runtime wiring (uncomment AFTER sync-custody-db.sh runs) -------
# The DSN is injected from the tool-gateway-custody-db secret by
# tool-gateway-delegated.yaml (secretKeyRef), NEVER set here — keep the
# credential out of committed env values, logs, and examples.
# GATEWAY_DELEGATED_CUSTODY_DB_URL is therefore intentionally absent.
#
# Absolute mount paths (the gateway reads these files directly). The keyring is
# the versioned custody key set; the config is the administered OAuth set file.
# GATEWAY_DELEGATED_CUSTODY_KEYRING_PATH=/etc/luban/delegated-keyring/keyring.json
# GATEWAY_DELEGATED_CUSTODY_CONFIG_PATH=/etc/luban/delegated/delegated-sets.json
# Set id selects which administered set in the config file this deployment uses.
# GATEWAY_DELEGATED_CUSTODY_SET_ID=user

# --- exact callback (plan line 165: "exact callback") -----------------------
# The gateway only accepts a redirect whose PATH is exactly
#   /api/v1/targets/authorizations/callback
# (tools/delegated_configuration.py CALLBACK_PATH). Any other path is rejected as
# callback_mismatch at load time, before any secret is created. Supply the full
# browser-reachable origin the OAuth provider redirects to; the path is fixed.
# GATEWAY_DELEGATED_CUSTODY_TRUSTED_CALLBACK=https://gateway.dev.internal/api/v1/targets/authorizations/callback

# --- delegated-human trust set (who may act as the requester) ---------------
# Pins the inbound human identity the gateway trusts to own a grant. Required
# (bounded issuer, http(s) JWKS URL, audience, non-empty actors) whenever a
# delegated gate is on; the gateway fails closed at startup if incomplete.
# GATEWAY_DELEGATED_IDENTITY_ISSUER=https://identity.dev.internal
# GATEWAY_DELEGATED_IDENTITY_JWKS_URL=http://identity-service:8000/.well-known/jwks.json
# GATEWAY_DELEGATED_IDENTITY_AUDIENCE=luban-tool-gateway
# GATEWAY_DELEGATED_IDENTITY_ACTORS=system:serviceaccount:dev-luban-aiops:platform-gateway

# --- workload verification trust sets (the gateway VERIFIES these) ----------
# The gateway does NOT mint these tokens; execution-runtime and platform-gateway
# present the projected service-account JWTs added by this overlay, and the
# gateway verifies issuer/jwks/audience/subject. Each set is required (bounded
# issuer, http(s) JWKS URL, audience, non-empty subject allowlist) when its gate
# is on.
#
# Execution handoff — private /api/v2/tools/invoke-delegated. The audience is the
# built-in default; the subject is the SA the presenter runs as. execution-runtime
# currently runs as the namespace default SA, so its projected subject is
# system:serviceaccount:dev-luban-aiops:default — pin exactly that, or migrate
# execution-runtime to a dedicated SA and pin the new subject.
# GATEWAY_EXECUTION_WORKLOAD_ISSUER=https://kubernetes.default.svc.cluster.local
# GATEWAY_EXECUTION_WORKLOAD_JWKS_URL=https://kubernetes.default.svc.cluster.local/openid/v1/jwks
# GATEWAY_EXECUTION_WORKLOAD_AUDIENCE=luban-target-execution-handoff
# GATEWAY_EXECUTION_WORKLOAD_SUBJECTS=system:serviceaccount:dev-luban-aiops:default
#
# Authorization handoff — bearerless /api/v2/targets/authorizations provider-url
# + callback. platform-gateway runs as the dedicated `platform-gateway` SA, so its
# projected subject is stable and allowlistable. A DISTINCT audience from the
# execution set means neither handoff can replay the other's token.
# GATEWAY_AUTHORIZATION_WORKLOAD_ISSUER=https://kubernetes.default.svc.cluster.local
# GATEWAY_AUTHORIZATION_WORKLOAD_JWKS_URL=https://kubernetes.default.svc.cluster.local/openid/v1/jwks
# GATEWAY_AUTHORIZATION_WORKLOAD_AUDIENCE=luban-target-authorization-handoff
# GATEWAY_AUTHORIZATION_WORKLOAD_SUBJECTS=system:serviceaccount:dev-luban-aiops:platform-gateway

# --- explicit token lifetimes ----------------------------------------------
# The projected workload-JWT lifetimes are set EXPLICITLY in the handoff-token
# patches (expirationSeconds), not here. The delegated ACCESS-token cache TTL and
# the refresh max-lifetime are per-set values in the ADMINISTERED CONFIG file
# (access_cache_ttl_seconds <= 300, refresh_max_lifetime_seconds <= 2592000),
# validated by custody_cli validate-config before any secret is written — they
# are never env vars, so they are never committed here.
