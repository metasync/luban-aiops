# SPEC-049 R-1: browser web-check posture for the dev environment.
# Merged into the platform-runtime-config ConfigMap by the dev-k8s
# overlay; the base keeps the connector disabled
# (GATEWAY_BROWSER_ENABLED=false in base/tool-gateway/runtime-config.env).
GATEWAY_BROWSER_ENABLED=true
GATEWAY_BROWSER_CDP_ENDPOINT=ws://localhost:9222
# Deny-by-default allowlist: the sample target app shipped by this
# profile is the only permitted origin.
GATEWAY_BROWSER_ALLOW_ORIGINS=http://browser-check-target:8080
GATEWAY_BROWSER_CREDENTIAL_SETS=/etc/luban/browser-credentials/credential-sets.json
