# SPEC-049 R-1: browser web-check posture for the dev environment.
# Merged into the platform-runtime-config ConfigMap by the dev-k8s
# overlay; the base keeps the connector disabled
# (GATEWAY_BROWSER_ENABLED=false in base/tool-gateway/runtime-config.env).
GATEWAY_BROWSER_ENABLED=true
GATEWAY_BROWSER_CDP_ENDPOINT=ws://localhost:9222
# Deny-by-default allowlist: the one permitted origin is `acme-admin`,
# the SPEC-059 sample application, deployed out-of-band by
# `make deploy-sample-app` because SPEC-050 R-11 keeps samples out of
# the base overlay and out of this profile's resources. Naming its
# origin here while the app is absent is harmless — the allowlist
# permits, it does not require. (SPEC-061 retired the static
# `browser-check-target` mock that was the second origin here.)
GATEWAY_BROWSER_ALLOW_ORIGINS=http://acme-admin:8080
GATEWAY_BROWSER_CREDENTIAL_SETS=/etc/luban/browser-credentials/credential-sets.json
# SPEC-058 R-7 / SPEC-059 R-5: the HTTP service-check surface, on the
# same origin as the browser surface so one profile runs both halves of
# a walkthrough. The base keeps GATEWAY_HTTP_ENABLED=false.
GATEWAY_HTTP_ENABLED=true
GATEWAY_HTTP_ALLOW_ORIGINS=http://acme-admin:8080
# GATEWAY_HTTP_CREDENTIAL_SETS is deliberately unset: it defaults to the
# browser credential-sets path, and `acme-admin` is one entry in that
# same file so the two surfaces cannot resolve different passwords.
# GATEWAY_MUTATING_TOOLS_ENABLED (needed for the write-tier http.post)
# comes from mutating-dev/mutating.env, which dev-k8s also merges.
