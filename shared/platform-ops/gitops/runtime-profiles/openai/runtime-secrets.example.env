AGENTSCOPE_API_KEY=replace-with-real-openai-api-key
# Optional for OpenAI-style providers that scope requests by organization.
# AGENTSCOPE_ORGANIZATION=optional-openai-organization

# Optional additional models (SPEC-024): each other supported provider with
# an API key here joins one selectable entry in the model catalog
# (id = provider name). Unset providers are dropped; the openai entry above
# stays the deploy-time default. Local-only: put real keys in the ignored
# runtime-secrets.env, never here.
# DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
# DASHSCOPE_API_KEY=replace-with-real-dashscope-api-key

# OTLP export auth for the opt-in OTel push pipeline (SPEC-005): Basic auth
# for the OpenObserve ingest endpoint. Provisioned by sync-otel-secrets.sh
# (never committed). Unset: push is anonymous, the backend answers 401 and
# the exporters fail open without affecting the service.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-email-colon-password
