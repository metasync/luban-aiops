# SPEC-067 R-6: ServiceNow read-tier Table-API ingestion posture for the dev
# environment. Merged into the platform-runtime-config ConfigMap by the dev-k8s
# overlay; the base keeps the connector disabled (servicenow_enabled defaults to
# false in core/config.py's from_env, so absent this profile every servicenow.*
# call fails closed with TOOL_NOT_FOUND — the deny-by-default posture R-3 asserts).
#
# This points the gateway's native REST connector at the in-cluster thin mock
# (servicenow-mock-table-api) over the Table API — the same wire a real ServiceNow
# tenant speaks. Swapping the mock for a live PDI (production) is a config-only
# change: a new base URL here and a new token_url in the credential set — never a
# connector-code change and never a model-selected value.
GATEWAY_SERVICENOW_ENABLED=true
GATEWAY_SERVICENOW_BASE_URL=http://servicenow-mock-table-api:8000
GATEWAY_SERVICENOW_TIMEOUT_MS=10000
# The named credential set resolves through the SPEC-068 seam from the JSON file
# mounted out of the tool-gateway-servicenow-credentials secret (written by
# sync-servicenow-credentials.sh, one generator / two sinks — the mock's OAuth
# responder validates the same client_id/client_secret and issues the same
# access_token). The set is scheme=oauth2_client_credentials (OQ-1); its
# token_url is http://servicenow-mock-table-api:8000/oauth_token.do. The value
# never travels through a prompt, a skill, or a tool result.
GATEWAY_SERVICENOW_CREDENTIAL_SET=servicenow-mock
GATEWAY_SERVICENOW_CREDENTIAL_SETS=/etc/luban/servicenow-credentials/credential-sets.json
# The admitted read-tool set (six tools), tiers, tables, field projections, and
# argument bounds are all gateway-owned operator config
# (ingestion/servicenow_binding.py), never model args and never target-derived.
