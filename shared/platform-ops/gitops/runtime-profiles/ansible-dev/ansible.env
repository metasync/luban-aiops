# SPEC-069 R-6: Ansible read-tier MCP-ingestion posture for the dev
# environment. Merged into the platform-runtime-config ConfigMap by the
# dev-k8s overlay; the base keeps the connector disabled
# (GATEWAY_ANSIBLE_MCP_ENABLED=false in base/tool-gateway/runtime-config.env).
#
# This points the gateway's server-agnostic MCP-ingestion connector at the
# in-cluster thin mock (ansible-mock-mcp) over streamable-HTTP — the same
# wire the production `ansible/aap-mcp-server` speaks. Swapping the mock for
# real AAP (production) or `lycorp-jp/awx-mcp` (open-source AWX) is a
# config-only change: a new URL here and, where tool names differ, a new
# binding — never an adapter-code change and never a model-selected value.
GATEWAY_ANSIBLE_MCP_ENABLED=true
GATEWAY_ANSIBLE_MCP_TRANSPORT=streamable_http
GATEWAY_ANSIBLE_MCP_URL=http://ansible-mock-mcp:8000/mcp
GATEWAY_ANSIBLE_MCP_TIMEOUT_MS=10000
# The named credential set resolves through the SPEC-068 seam from the JSON
# file mounted out of the tool-gateway-ansible-credentials secret (written by
# sync-ansible-credentials.sh, one generator / two sinks — the mock's bearer
# gate reads the same token). The value never travels through a prompt, a
# skill, or a tool result.
GATEWAY_ANSIBLE_MCP_CREDENTIAL_SET=ansible-mock
GATEWAY_ANSIBLE_MCP_CREDENTIAL_SETS=/etc/luban/ansible-credentials/credential-sets.json
# GATEWAY_ANSIBLE_NATIVE_ENABLED is deliberately left unset (base keeps it
# false): the native `ansible-inventory` shell-out is the OQ-1 fallback for
# when no MCP server is wired, and this profile wires one. The admitted
# read-tool list, tiers, endpoint, and executable path are all gateway-owned
# operator config (ingestion/ansible_binding.py + this file), never model args.
