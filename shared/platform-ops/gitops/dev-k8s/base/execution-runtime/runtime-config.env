# SPEC-038: execution-runtime worker configuration.
# TOOL_GATEWAY_URL is intentionally not repeated here: the merged
# platform-runtime-config ConfigMap already carries it from
# agent-platform/runtime-config.env (same value), and duplicate keys
# across envs files fail kustomize generation.
EXECUTION_STATE_STORE_BACKEND=postgres
EXECUTION_STATE_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/sessions
# Audit emission for execution_completed / execution_rejected events;
# the ingest credential (EXECUTION_AUDIT_CLIENT_SECRET) rides the
# execution-runtime-runtime-secrets secret provisioned by
# sync-audit-secrets.sh.
EXECUTION_AUDIT_SERVICE_URL=http://audit-service:8000
EXECUTION_AUDIT_CLIENT_ID=execution-runtime
