KEYCLOAK_BASE_URL=https://idp.apps.metasync.cc
# Self-contained Luban AIOps realm on the shared dev Keycloak; reconciled by
# shared/platform-ops/gitops/reconcile-luban-realm.sh (groups, test users).
KEYCLOAK_REALM=luban-aiops
OIDC_CLIENT_ID=luban-aiops-portal
# Primary callback is the Envoy Gateway hostname; extras keep the second
# gateway hostname and the localhost port-forward path working as well.
OIDC_REDIRECT_URI=https://aiops.luban.metasync.cc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://aiops.luban.metasync.cc/
OIDC_EXTRA_REDIRECT_URIS=https://aiops.luban.k8s.orb.local/callback,http://localhost:18080/callback
OIDC_EXTRA_POST_LOGOUT_REDIRECT_URIS=https://aiops.luban.k8s.orb.local/,http://localhost:18080/
OIDC_SCOPES=openid groups
IDENTITY_TOKEN_AUDIENCE=platform-gateway
IDENTITY_DELEGATED_TOKEN_TTL_SECONDS=300
# Durable audit trail (SPEC-013 R-3). The ingest secret arrives via the
# identity-service-runtime-secrets secret (IDENTITY_AUDIT_CLIENT_SECRET).
IDENTITY_AUDIT_SERVICE_URL=http://audit-service:8000
IDENTITY_AUDIT_CLIENT_ID=identity-broker
