AGENT_SERVICE_URL=http://agent-service:8000
PLATFORM_GATEWAY_DEV_USER=demo.operator
PLATFORM_GATEWAY_REQUIRE_AUTH=true
PLATFORM_GATEWAY_POLICY_PATH=/etc/luban/policy/policy.yaml
PLATFORM_GATEWAY_TOKEN_AUDIENCE=platform-gateway
PLATFORM_GATEWAY_DELEGATION_AUDIENCE=tool-gateway
PLATFORM_GATEWAY_SERVICE_CLIENT_ID=platform-gateway
# Durable audit trail (SPEC-013 R-3/R-4). The ingest secret arrives via the
# platform-gateway-runtime-secrets secret (PLATFORM_GATEWAY_AUDIT_CLIENT_SECRET).
PLATFORM_GATEWAY_AUDIT_SERVICE_URL=http://audit-service:8000
PLATFORM_GATEWAY_AUDIT_CLIENT_ID=platform-gateway
# Incident triage and collaboration (SPEC-015). The query secret arrives via
# the platform-gateway-runtime-secrets secret
# (PLATFORM_GATEWAY_INCIDENT_CLIENT_SECRET).
PLATFORM_GATEWAY_INCIDENT_SERVICE_URL=http://incident-service:8000
PLATFORM_GATEWAY_INCIDENT_CLIENT_ID=platform-gateway
# Workspace inventory proxies (SPEC-019 R-4). The skills query secret arrives
# via the platform-gateway-runtime-secrets secret
# (PLATFORM_GATEWAY_SKILLS_CLIENT_SECRET).
PLATFORM_GATEWAY_TOOL_GATEWAY_URL=http://tool-gateway:8000
PLATFORM_GATEWAY_SKILLS_HUB_URL=http://skills-hub:8000
PLATFORM_GATEWAY_SKILLS_CLIENT_ID=platform-gateway
# Bounded-diagnosis proxy budget (SPEC-076 R-7). The dev cluster drives the
# read-only fan-out against a real remote LLM provider, whose member turns plus
# context compression push a legitimate bounded diagnosis past the 120s code
# default (observed ~140s), so the proxy would ReadTimeout before agent-service
# returns 200. Raise the dev budget to 300s; the code default is tracked as a
# follow-up finding, not changed here.
PLATFORM_GATEWAY_DIAGNOSE_TIMEOUT_SECONDS=300
