# Example secret contract for the skills-hub deployment (SPEC-014 R-3).
# Copy to runtime-secrets.env (never committed) and replace the placeholders,
# or run shared/platform-ops/gitops/sync-skills-secrets.sh which generates one
# shared query secret and writes every runtime-secrets.env file. Sync into
# the cluster as the optional Secret 'skills-hub-runtime-secrets' referenced
# by the skills-hub deployment.
#
# SKILLS_QUERY_CLIENTS registers the callers permitted to query skills.
# Format: comma-separated entries of client_id=client_secret. Each caller's
# query secret (tool-gateway GATEWAY_SKILLS_CLIENT_SECRET, platform-gateway
# PLATFORM_GATEWAY_SKILLS_CLIENT_SECRET) must match the secret registered
# here for its client id.
SKILLS_QUERY_CLIENTS=tool-gateway=replace-with-shared-skills-query-secret,platform-gateway=replace-with-shared-skills-query-secret

# SKILLS_GIT_TOKENS authenticates type=git federation sources. Format: JSON
# map of source_id -> token (injected into the clone URL as x-access-token).
# Provisioned by sync-skills-secrets.sh when SKILLS_GIT_TOKEN is exported;
# never committed. Without it the git source fails auth (scrubbed error on
# the status endpoint) while all other sources keep serving.
SKILLS_GIT_TOKENS={"platform-skills":"replace-with-git-source-pat"}

# OTLP export auth for the opt-in OTel push pipeline (SPEC-005): Basic auth
# for the OpenObserve ingest endpoint. Provisioned by sync-otel-secrets.sh
# (never committed). Unset: push is anonymous, the backend answers 401 and
# the exporters fail open without affecting the service.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-email-colon-password
