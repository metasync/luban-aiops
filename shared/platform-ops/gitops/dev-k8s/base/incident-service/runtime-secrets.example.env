# Example secret contract for the incident-service deployment (SPEC-015).
# Copy to runtime-secrets.env (never committed) and replace the placeholders,
# or run shared/platform-ops/gitops/sync-incident-secrets.sh which generates
# the webhook token and the shared query secret and writes every
# runtime-secrets.env file. Sync into the cluster as the optional Secret
# 'incident-service-runtime-secrets' referenced by the incident-service
# deployment.
#
# INCIDENT_WEBHOOK_TOKEN authenticates the Alertmanager webhook intake
# (POST /api/v1/webhooks/alertmanager, bearer token). Configure the same
# value in the Alertmanager webhook receiver.
INCIDENT_WEBHOOK_TOKEN=replace-with-webhook-token

# INCIDENT_QUERY_CLIENTS registers the platform callers permitted to query
# and trigger triage. Format: comma-separated entries of client_id=secret.
# platform-gateway's PLATFORM_GATEWAY_INCIDENT_CLIENT_SECRET and
# tool-gateway's GATEWAY_INCIDENTS_CLIENT_SECRET must each match the secret
# registered here for their client id.
INCIDENT_QUERY_CLIENTS=platform-gateway=replace-with-shared-incident-query-secret,tool-gateway=replace-with-shared-incident-query-secret

# INCIDENT_AUDIT_CLIENT_SECRET authenticates the built-in audit connector
# against audit-service's ingest registry (AUDIT_INGEST_CLIENTS).
# Provisioned by sync-audit-secrets.sh (all emitters share one secret).
INCIDENT_AUDIT_CLIENT_SECRET=replace-with-shared-audit-ingest-secret

# OTLP export auth for the opt-in OTel push pipeline (SPEC-005): Basic auth
# for the OpenObserve ingest endpoint. Provisioned by sync-otel-secrets.sh
# (never committed). Unset: push is anonymous, the backend answers 401 and
# the exporters fail open without affecting the service.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-email-colon-password
