INCIDENT_STORE_BACKEND=postgres
INCIDENT_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/incidents
# Triage relays the operator's delegated bearer straight to agent-platform
# (SPEC-015 R-3); the DNS name matches the agent-service Service.
INCIDENT_AGENT_SERVICE_URL=http://agent-service:8000
# Built-in audit connector (SPEC-015 R-5): triage reports are dispatched to
# the durable trail. The ingest secret arrives via the
# incident-service-runtime-secrets secret (INCIDENT_AUDIT_CLIENT_SECRET),
# provisioned by sync-audit-secrets.sh.
INCIDENT_CONNECTORS=audit
INCIDENT_AUDIT_SERVICE_URL=http://audit-service:8000
INCIDENT_AUDIT_CLIENT_ID=incident-service
# Intake secrets (INCIDENT_WEBHOOK_TOKEN, INCIDENT_QUERY_CLIENTS) arrive via
# the incident-service-runtime-secrets secret, provisioned by
# sync-incident-secrets.sh.
