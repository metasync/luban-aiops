# Shared runtime env for every pod (single ConfigMap; each key may appear once).
# SPEC-005: OTel push pipeline is opt-in; /metrics stays on regardless.
OTEL_ENABLED=false
# Uncomment and point at the Elastic APM / OTLP collector to enable push:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://apm-server:8200
# Broker endpoint used by both gateways (platform-gateway and tool-gateway).
IDENTITY_SERVICE_URL=http://identity-service:8000
