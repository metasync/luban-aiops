# Shared runtime env for every pod (single ConfigMap; each key may appear once).
# SPEC-005: OTel push pipeline is opt-in; /metrics stays on regardless.
OTEL_ENABLED=true
# OpenObserve OTLP HTTP ingest: the proto-http exporters append the
# per-signal /v1/{traces,metrics,logs} paths, so the endpoint stops at the
# org prefix (/api/default). Auth rides on OTEL_EXPORTER_OTLP_HEADERS,
# provisioned into each service's runtime-secrets Secret by
# sync-otel-secrets.sh (never committed).
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve-router.openobserve.svc.cluster.local:5080/api/default
# Broker endpoint used by both gateways (platform-gateway and tool-gateway).
IDENTITY_SERVICE_URL=http://identity-service:8000
