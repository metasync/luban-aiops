# Example secret contract for the tool-gateway deployment (SPEC-013 R-3).
# Copy to runtime-secrets.env (never committed) and replace the placeholder,
# or run shared/platform-ops/gitops/sync-audit-secrets.sh which generates the
# shared ingest secret and writes this file. Sync into the cluster as the
# optional Secret 'tool-gateway-runtime-secrets' referenced by the
# tool-gateway deployment.
#
# GATEWAY_AUDIT_CLIENT_SECRET must match the secret registered for client id
# 'tool-gateway' in the audit-service's AUDIT_INGEST_CLIENTS registry.
GATEWAY_AUDIT_CLIENT_SECRET=replace-with-shared-audit-ingest-secret
# GATEWAY_SKILLS_CLIENT_SECRET must match the secret registered for client id
# 'tool-gateway' in the skills-hub's SKILLS_QUERY_CLIENTS registry
# (SPEC-014 R-3); provisioned by sync-skills-secrets.sh.
GATEWAY_SKILLS_CLIENT_SECRET=replace-with-shared-skills-query-secret

# OTLP export auth for the opt-in OTel push pipeline (SPEC-005): Basic auth
# for the OpenObserve ingest endpoint. Provisioned by sync-otel-secrets.sh
# (never committed). Unset: push is anonymous, the backend answers 401 and
# the exporters fail open without affecting the service.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-email-colon-password
