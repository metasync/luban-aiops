# Example secret contract for the tool-gateway deployment (SPEC-013 R-3).
# Copy to runtime-secrets.env (never committed) and replace the placeholder,
# or run shared/platform-ops/gitops/sync-audit-secrets.sh which generates the
# shared ingest secret and writes this file. Sync into the cluster as the
# optional Secret 'tool-gateway-runtime-secrets' referenced by the
# tool-gateway deployment.
#
# GATEWAY_AUDIT_CLIENT_SECRET must match the secret registered for client id
# 'tool-gateway' in the audit-service's AUDIT_INGEST_CLIENTS registry.
GATEWAY_AUDIT_CLIENT_SECRET=replace-with-shared-audit-ingest-secret
