GATEWAY_DEV_USER=demo.operator
GATEWAY_REQUIRE_AUTH=true
GATEWAY_POLICY_PATH=/etc/luban/policy/policy.yaml
GATEWAY_K8S_ENABLED=true
GATEWAY_K8S_NAMESPACE=dev-luban-aiops
# Mutating tools (SPEC-021). While false, write/admin risk tools are not
# registered: they are absent from discovery and invoke returns
# TOOL_NOT_FOUND. Opting in requires ALL of:
#   1. Set GATEWAY_MUTATING_TOOLS_ENABLED=true here
#   2. tools:mutate grants reviewed in the policy bundle (default grants
#      platform-admin + operator only)
#   3. Opt-in RBAC applied, e.g. kubectl apply -f
#      shared/platform-ops/gitops/dev-k8s/base/tool-gateway/tool-gateway-pod-delete.yaml
#   4. AGENT_HITL_CONFIRM_TIMEOUT>0 on agent-platform (else mutating tools
#      are excluded from the agent toolkit entirely)
# See docs/guides/approval-and-hitl.md and the activation checklist in
# docs/guides/tool-configuration.md.
GATEWAY_MUTATING_TOOLS_ENABLED=false
GATEWAY_TOKEN_AUDIENCE=tool-gateway
GATEWAY_ELASTIC_ENABLED=false
# Durable audit trail (SPEC-013 R-3). The ingest secret arrives via the
# tool-gateway-runtime-secrets secret (GATEWAY_AUDIT_CLIENT_SECRET).
GATEWAY_AUDIT_SERVICE_URL=http://audit-service:8000
GATEWAY_AUDIT_CLIENT_ID=tool-gateway
# Skills and grounded guidance (SPEC-014 R-4). The query secret arrives via
# the tool-gateway-runtime-secrets secret (GATEWAY_SKILLS_CLIENT_SECRET).
GATEWAY_SKILLS_SERVICE_URL=http://skills-hub:8000
GATEWAY_SKILLS_CLIENT_ID=tool-gateway
# Live incident context (SPEC-015): read-only incidents.list / incidents.get.
# The query secret arrives via the tool-gateway-runtime-secrets secret
# (GATEWAY_INCIDENTS_CLIENT_SECRET).
GATEWAY_INCIDENTS_SERVICE_URL=http://incident-service:8000
GATEWAY_INCIDENTS_CLIENT_ID=tool-gateway
# GATEWAY_ELASTIC_URL=https://elastic.example.com:9200
# GATEWAY_ELASTIC_API_KEY=<base64-api-key>
# GATEWAY_ELASTIC_USERNAME=elastic
# GATEWAY_ELASTIC_PASSWORD=<password>
# GATEWAY_ELASTIC_VERIFY_TLS=true
# GATEWAY_ELASTIC_ALERTS_INDEX=.alerts-*
