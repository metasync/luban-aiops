GATEWAY_DEV_USER=demo.operator
GATEWAY_REQUIRE_AUTH=true
GATEWAY_POLICY_PATH=/etc/luban/policy/policy.yaml
GATEWAY_K8S_ENABLED=true
GATEWAY_K8S_NAMESPACE=dev-luban-aiops
GATEWAY_TOKEN_AUDIENCE=tool-gateway
GATEWAY_ELASTIC_ENABLED=false
# GATEWAY_ELASTIC_URL=https://elastic.example.com:9200
# GATEWAY_ELASTIC_API_KEY=<base64-api-key>
# GATEWAY_ELASTIC_USERNAME=elastic
# GATEWAY_ELASTIC_PASSWORD=<password>
# GATEWAY_ELASTIC_VERIFY_TLS=true
# GATEWAY_ELASTIC_ALERTS_INDEX=.alerts-*
