GATEWAY_DEV_USER=demo.operator
GATEWAY_REQUIRE_AUTH=true
GATEWAY_POLICY_PATH=/etc/luban/policy/policy.yaml
GATEWAY_K8S_ENABLED=true
GATEWAY_K8S_NAMESPACE=dev-luban-aiops
# Mutating tools (SPEC-021). While false, write/admin risk tools are not
# registered: they are absent from discovery and invoke returns
# TOOL_NOT_FOUND. This base value stays false — the dev-k8s environment
# opts in through the runtime-profiles/mutating-dev profile (SPEC-022
# R-3), which merges GATEWAY_MUTATING_TOOLS_ENABLED=true and carries the
# pod-delete RBAC. Activating mutating tools in any environment requires
# ALL of:
#   1. GATEWAY_MUTATING_TOOLS_ENABLED=true in the rendered runtime config
#   2. tools:mutate grants reviewed in the policy bundle (default grants
#      platform-admin + operator only)
#   3. Pod-delete RBAC applied
#      (runtime-profiles/mutating-dev/tool-gateway-pod-delete.yaml)
#   4. AGENT_HITL_CONFIRM_TIMEOUT>0 on agent-platform (else mutating tools
#      are excluded from the agent toolkit entirely)
# See docs/guides/approval-and-hitl.md and the activation checklist in
# docs/guides/tool-configuration.md.
GATEWAY_MUTATING_TOOLS_ENABLED=false
# Browser web-check tools (SPEC-049). While disabled, no web.* tool is
# registered: it is absent from discovery and invoke returns
# TOOL_NOT_FOUND. Even when enabled, the origin allowlist is
# deny-by-default — navigation is refused unless an origin is listed.
# The dev-k8s environment opts in through the runtime-profiles/browser-dev
# profile (SPEC-049 R-7), which merges GATEWAY_BROWSER_ENABLED=true,
# ships the chromium-headless-shell sidecar, the sample target app, and
# the dev origin allowlist. Activating browser tools in any environment
# requires ALL of:
#   1. GATEWAY_BROWSER_ENABLED=true in the rendered runtime config
#   2. GATEWAY_BROWSER_ALLOW_ORIGINS listing every permitted origin
#   3. A reachable CDP endpoint (GATEWAY_BROWSER_CDP_ENDPOINT)
#   4. AGENT_HITL_CONFIRM_TIMEOUT>0 on agent-platform for write-class
#      flows (else write-tier tools are excluded from the agent toolkit)
# See docs/guides/tool-configuration.md.
GATEWAY_BROWSER_ENABLED=false
# GATEWAY_BROWSER_CDP_ENDPOINT=ws://localhost:9222
# GATEWAY_BROWSER_ALLOW_ORIGINS=https://app.internal
# GATEWAY_BROWSER_SESSION_TTL=600
# GATEWAY_BROWSER_MAX_SESSIONS=4
# GATEWAY_BROWSER_FLOW_MAX_STEPS=20
# GATEWAY_BROWSER_CREDENTIAL_SETS=/etc/luban/browser-credentials/credential-sets.json
# GATEWAY_BROWSER_SCREENSHOT_MAX_BYTES=65536
# HTTP service-check tools (SPEC-058). While disabled, no http.* tool is
# registered: it is absent from discovery and invoke returns
# TOOL_NOT_FOUND. Even when enabled, the origin allowlist is
# deny-by-default — a request is refused unless its origin is listed, and
# a redirect that leaves the allowlist halts. http.get is read tier;
# http.post is write tier and additionally needs the mutating posture. The
# dev-k8s environment opts in through the runtime-profiles/browser-dev
# profile (SPEC-059 R-5), which merges GATEWAY_HTTP_ENABLED=true and the
# sample app's dev origin allowlist. The base names no origin — SPEC-050
# R-11's rule that the base never names a sample applies to allowlist
# entries exactly as it does to Deployments. Activating HTTP tools in any
# environment requires ALL of:
#   1. GATEWAY_HTTP_ENABLED=true in the rendered runtime config
#   2. GATEWAY_HTTP_ALLOW_ORIGINS listing every permitted origin
#   3. GATEWAY_MUTATING_TOOLS_ENABLED=true for http.post (write tier),
#      with tools:mutate grants reviewed in the policy bundle
#   4. AGENT_HITL_CONFIRM_TIMEOUT>0 on agent-platform for http.post
#      (else write-tier tools are excluded from the agent toolkit)
# See docs/guides/tool-configuration.md.
GATEWAY_HTTP_ENABLED=false
# GATEWAY_HTTP_ALLOW_ORIGINS=https://api.internal
# GATEWAY_HTTP_TIMEOUT_MS=10000
# GATEWAY_HTTP_MAX_RESPONSE_BYTES=65536
# GATEWAY_HTTP_MAX_REQUEST_BYTES=4096
# GATEWAY_HTTP_CREDENTIAL_SETS=/etc/luban/browser-credentials/credential-sets.json
# Secure generation and one-time portal copy (SPEC-062). Activation requires:
#   1. GATEWAY_SECRETS_ENABLED=true and a readable password-policy contract
#   2. Working identity delegation and tools:invoke permission
#   3. HTTPS/localhost clipboard access in the portal
# Email additionally requires mutating tools, HITL, signed execution, and
# tools:mutate + secrets:deliver grants. SMTP is deliberately unconfigured here.
# Keep the agent and gateway recipient allowlists identical. SMTP credentials
# belong in a Secret, provisioned explicitly by gitops/sync-email-secrets.sh.
GATEWAY_SECRETS_ENABLED=false
GATEWAY_PASSWORD_POLICY_PATH=/etc/luban/policy/password-policy.yaml
# GATEWAY_PASSWORD_MIN_LENGTH=20
# GATEWAY_PASSWORD_REQUIRED_CLASSES=upper,lower,digit,symbol
# GATEWAY_PASSWORD_EXCLUDE_AMBIGUOUS=true
GATEWAY_SECRET_DELIVERY_BACKEND=memory
# GATEWAY_SECRET_DELIVERY_TTL_SECONDS=300
# Reveal-on-commit (SPEC-062 R-3): a portal-copy delivery stashes under this
# longer hold so it survives a full HITL approval wait before the Copy-password
# button is revealed on the committed turn (900 = 600 approval timeout + 300
# redemption margin). Because the hold now spans the approval window, a
# multi-replica or restart-sensitive deployment should select the redis backend
# below so an in-flight handoff is not dropped; dev stays on memory.
# GATEWAY_SECRET_DELIVERY_HOLD_TTL_SECONDS=900
# GATEWAY_SECRET_DELIVERY_MAX_ENTRIES=256
# For multiple replicas, select redis and check that startup did not fall back.
# GATEWAY_SECRET_DELIVERY_REDIS_HOST=redis
# GATEWAY_SECRET_DELIVERY_REDIS_PORT=6379
# GATEWAY_SECRET_DELIVERY_REDIS_DB=2
# GATEWAY_EMAIL_HOST=smtp.internal
# GATEWAY_EMAIL_PORT=587
# GATEWAY_EMAIL_USER=service@example.com
# GATEWAY_EMAIL_FROM=service@example.com
# GATEWAY_EMAIL_USE_TLS=true
# GATEWAY_EMAIL_RECIPIENT_ALLOWLIST=example.com,operator@partner.example
# GATEWAY_EMAIL_STRICT_ALLOWLIST=true
GATEWAY_TOKEN_AUDIENCE=tool-gateway
GATEWAY_ELASTIC_ENABLED=false
# Durable audit trail (SPEC-013 R-3). The ingest secret arrives via the
# tool-gateway-runtime-secrets secret (GATEWAY_AUDIT_CLIENT_SECRET).
GATEWAY_AUDIT_SERVICE_URL=http://audit-service:8000
GATEWAY_AUDIT_CLIENT_ID=tool-gateway
# Skills and grounded guidance (SPEC-014 R-4). The query secret arrives via
# the tool-gateway-runtime-secrets secret (GATEWAY_SKILLS_CLIENT_SECRET).
GATEWAY_SKILLS_SERVICE_URL=http://skills-hub:8000
GATEWAY_SKILLS_CLIENT_ID=tool-gateway
# Live incident context (SPEC-015): read-only incidents.list / incidents.get.
# The query secret arrives via the tool-gateway-runtime-secrets secret
# (GATEWAY_INCIDENTS_CLIENT_SECRET).
GATEWAY_INCIDENTS_SERVICE_URL=http://incident-service:8000
GATEWAY_INCIDENTS_CLIENT_ID=tool-gateway
# GATEWAY_ELASTIC_URL=https://elastic.example.com:9200
# GATEWAY_ELASTIC_API_KEY=<base64-api-key>
# GATEWAY_ELASTIC_USERNAME=elastic
# GATEWAY_ELASTIC_PASSWORD=<password>
# GATEWAY_ELASTIC_VERIFY_TLS=true
# GATEWAY_ELASTIC_ALERTS_INDEX=.alerts-*
