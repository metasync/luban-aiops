AGENT_TRANSITIONAL_PORT=8000
AGENTSCOPE_AGENT_NAME=LubanOpsRuntime
# AGENTSCOPE_SYSTEM_PROMPT intentionally unset: fall back to the hardened
# DEFAULT_SYSTEM_PROMPT in code (anti-fabrication guardrails included).
AGENTSCOPE_REDIS_HOST=redis
AGENTSCOPE_REDIS_PORT=6379
AGENTSCOPE_REDIS_DB=0
AGENTSCOPE_WORKSPACE_DIR=/var/lib/luban-aiops/workspaces/agent-platform
AGENTSCOPE_WORKSPACE_TTL_SECONDS=3600
SESSION_STORE_BACKEND=postgres
SESSION_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/sessions
AGENT_STATE_STORE_BACKEND=postgres
AGENT_STATE_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/sessions
# Kernel tuning knobs (SPEC-017 R-1) intentionally unset in dev: code
# defaults apply (max_iters=20, context_trigger_ratio=0.8,
# tool_result_limit=50000, timezone=UTC, model_max_retries=0).
# Kernel middleware knobs (SPEC-018): OTel kernel tracing is on so dev
# spans flow through the existing OTLP exporter; the reply token budget
# and built-in task tools stay off (recommended starting points when
# opting in: AGENTSCOPE_REPLY_TOKEN_BUDGET=20000,
# AGENTSCOPE_TASK_TOOLS_ENABLED=true).
AGENTSCOPE_KERNEL_TRACING=true
TOOL_GATEWAY_URL=http://tool-gateway:8000
