AUDIT_STORE_BACKEND=postgres
AUDIT_DB_URL=postgresql://audit:audit-dev-local@postgres:5432/audit
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_EVENTS=100000
AUDIT_EVICTION_INTERVAL_SECONDS=3600
# Ingest credentials arrive via the audit-service-runtime-secrets secret
# (AUDIT_INGEST_CLIENTS), provisioned by sync-audit-secrets.sh.
