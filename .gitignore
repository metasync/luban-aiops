.DS_Store
.idea/
.vscode/

.env
.env.*
!.env.example

node_modules/
dist/
build/
coverage/
.turbo/
.next/

.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.coverage
**/.workspaces/

*.log

# Dot-prefixed per-session scratch logs (`.build-*.log`, `.deploy-*.log`,
# `.pf-*.log`, ...) — `*.log` does not anchor them. Keeping them untracked
# and ignored prevents the coordinated IMAGE_TAG from gaining `-dirty`.
.*.log

# Dot-prefixed per-session scratch SQL (`.sqlcheck-*.sql`) — the real-database
# migration checks a spec's `tasks.md` cites as evidence, so they stay on disk
# for the reader but out of git, for the same IMAGE_TAG reason as the logs.
.sqlcheck-*.sql

# Local verification screenshots captured by browser-based checks.
*.png

# Local runtime profile secrets and local image-tag state.
shared/platform-ops/gitops/**/runtime-secrets.env
shared/platform-ops/gitops/**/.images.env

# Auto-generated dev signing keys (identity-broker JWT).
.dev-keys/

# IDE-local better-harness session reports (generated churn, never tracked).
.qoder/better-harness/

# IDE-generated Repo Wiki cache. Formerly tracked; now untracked and ignored so
# the indexer's regeneration churn no longer dirties the working tree (which
# forced `make build` to emit -dirty-<timestamp> tags instead of dev-k8s-<sha>).
# Pair this with disabling Auto Update / Auto Export in the IDE so the directory
# is not regenerated; the curated docs under docs/ are the maintained source now.
.qoder/repowiki/
