.coverage
**/.workspaces/

*.log

# Dot-prefixed per-session scratch logs (`.build-*.log`, `.deploy-*.log`,
# `.pf-*.log`, ...) — `*.log` does not anchor them. Keeping them untracked
# and ignored prevents the coordinated IMAGE_TAG from gaining `-dirty`.
.*.log

# Local verification screenshots captured by browser-based checks.
*.png

# Local runtime profile secrets and local image-tag state.
shared/platform-ops/gitops/**/runtime-secrets.env
shared/platform-ops/gitops/**/.images.env

# Auto-generated dev signing keys (identity-broker JWT).
.dev-keys/

# IDE-local better-harness session reports (generated churn, like repowiki
# but never tracked).
.qoder/better-harness/
