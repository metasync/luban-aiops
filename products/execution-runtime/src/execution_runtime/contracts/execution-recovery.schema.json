{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metasync.github.io/luban-aiops/schemas/execution-recovery.schema.json",
  "title": "Execution Recovery (v1)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "nullableUuid": {"anyOf": [{"$ref": "execution-observation.schema.json#/$defs/uuid"}, {"type": "null"}]},
    "nullableId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "nullableTime": {"anyOf": [{"$ref": "execution-observation.schema.json#/$defs/time"}, {"type": "null"}]}
  },
  "required": ["recovery_version", "availability", "state", "execution_id", "confirm_id", "call_id", "session_id",
               "run_id", "admission_epoch", "tool_name", "attempt_request_id", "request_digest", "requested_at", "expires_at",
               "claimed_at", "observe_by", "as_of", "replay", "run_stopped", "integrity_conflict",
               "target_verification_required", "receipt", "observations", "observations_truncated", "next_observation_cursor"],
  "properties": {
    "recovery_version": {"const": 1},
    "availability": {"enum": ["available", "unavailable", "not_found"]},
    "state": {"enum": [null, "not_dispatched", "dispatch_claimed", "outcome_unknown", "result_recorded"]},
    "preparation_state": {"const": "registered"},
    "execution_id": {"$ref": "#/$defs/nullableUuid"},
    "confirm_id": {"$ref": "#/$defs/nullableUuid"},
    "call_id": {"$ref": "#/$defs/nullableId"},
    "session_id": {"$ref": "#/$defs/nullableId"},
    "run_id": {"$ref": "#/$defs/nullableUuid"},
    "admission_epoch": {"$ref": "#/$defs/nullableUuid"},
    "tool_name": {"type": ["string", "null"], "maxLength": 128},
    "attempt_request_id": {"anyOf": [{"$ref": "execution-observation.schema.json#/$defs/id"}, {"type": "null"}]},
    "request_digest": {"anyOf": [{"$ref": "execution-observation.schema.json#/$defs/digest"}, {"type": "null"}]},
    "requested_at": {"$ref": "#/$defs/nullableTime"},
    "expires_at": {"$ref": "#/$defs/nullableTime"},
    "claimed_at": {"$ref": "#/$defs/nullableTime"},
    "observe_by": {"$ref": "#/$defs/nullableTime"},
    "as_of": {"$ref": "#/$defs/nullableTime"},
    "replay": {"type": "boolean"},
    "run_stopped": {"type": "boolean"},
    "integrity_conflict": {"type": "boolean"},
    "target_verification_required": {"type": "boolean"},
    "receipt": {"anyOf": [{"$ref": "execution-receipt.schema.json"}, {"type": "null"}]},
    "observations": {"type": "array", "maxItems": 20, "items": {"$ref": "execution-observation.schema.json"}},
    "observations_truncated": {"type": "boolean"},
    "next_observation_cursor": {"type": ["string", "null"], "maxLength": 2048}
  },
  "allOf": [
    {"if": {"properties": {"availability": {"enum": ["unavailable", "not_found"]}}},
     "then": {"properties": {"state": {"type": "null"}, "receipt": {"type": "null"},
                              "observations": {"maxItems": 0}, "next_observation_cursor": {"type": "null"}},
              "not": {"required": ["preparation_state"]}}},
    {"if": {"required": ["preparation_state"]},
     "then": {"properties": {"availability": {"const": "available"}, "state": {"type": "null"}, "claimed_at": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "result_recorded"}}},
     "then": {"properties": {"receipt": {"type": "object"}, "target_verification_required": {"const": true}}}}
  ]
}
